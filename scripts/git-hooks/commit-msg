#!/usr/bin/env sh
# Reject AI co-author trailers (AGENTS.md rule 8). Commits use the developer's own identity.
if grep -qiE '^[[:space:]]*co-authored-by:' "$1"; then
  echo "commit-msg: remove the Co-Authored-By trailer; this repo allows no AI co-author trailers." >&2
  exit 1
fi
if grep -qiE 'generated with \[?claude|generated by (claude|codex|chatgpt)' "$1"; then
  echo "commit-msg: remove the 'Generated with ...' line; commits carry no AI attribution here." >&2
  exit 1
fi
exit 0
