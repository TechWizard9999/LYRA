#!/usr/bin/env sh
# Reject every Co-Authored-By trailer. AGENTS.md rule 8 forbids AI co-author trailers; this hook is
# stricter on purpose: commits here are single-author, with the developer's own identity.
if grep -qiE '^[[:space:]]*co-authored-by:' "$1"; then
  echo "commit-msg: remove the Co-Authored-By trailer; commits in this repo are single-author (no AI or human co-author trailers)." >&2
  exit 1
fi
if grep -qiE 'generated with \[?claude|generated by (claude|codex|chatgpt)' "$1"; then
  echo "commit-msg: remove the 'Generated with ...' line; commits carry no AI attribution here." >&2
  exit 1
fi
exit 0
