#!/usr/bin/env sh
# Keep the staged .claude/skills in sync with the staged .agents/skills (the index, not the working tree),
# and rustfmt clean when Rust files are staged.
staged="$(git diff --cached --name-only)"

if printf '%s\n' "$staged" | grep -qE '^(\.agents/skills/|\.claude/skills/)'; then
  ./scripts/agents.sh check-staged || exit 1
fi

if printf '%s\n' "$staged" | grep -qE '\.rs$' && command -v cargo >/dev/null 2>&1; then
  cargo fmt --all -- --check >/dev/null 2>&1 || { echo "pre-commit: cargo fmt --all needed" >&2; exit 1; }
fi
exit 0
